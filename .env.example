# LLM — 选择一个 provider 配置即可
# 方式 1：火山引擎方舟（OpenAI 兼容协议，推荐）
OPENAI_API_KEY=your-volcengine-ark-api-key
OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DEFAULT_MODEL=openai/deepseek-v3-250324

# 方式 2：Anthropic 直连
# ANTHROPIC_API_KEY=sk-ant-xxx
# DEFAULT_MODEL=anthropic/claude-haiku-4-5-20251001

# 方式 3：DeepSeek 直连
# DEEPSEEK_API_KEY=sk-xxx
# DEFAULT_MODEL=deepseek/deepseek-chat

# Auth
ADMIN_API_KEY=your-admin-key-here
WIDGET_TOKEN_SECRET=your-secret-here

# DB
DATABASE_URL=sqlite+aiosqlite:///./data/cs.db

# Embedding（本地模型，首次运行自动下载 ~3.2GB）
EMBEDDING_MODEL=Alibaba-NLP/gte-Qwen2-1.5B-instruct

# Reranker（本地模型，首次运行自动下载 ~2.1GB）
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
